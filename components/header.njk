[# header: logo bar.

   Compatibility
   - Outlook desktop: no dark-mode swap, so it always shows the light logo (the .logo-dark image stays hidden).
   - Gmail apps: may auto-invert colors and ignore prefers-color-scheme. Use a logo with a transparent
     background that reads on both light and dark if the dark swap matters.
   - Dark logo swap: only emitted when the brand defines dark.logoUrl. #]
[% macro header() %]
<mj-section css-class="dm-surface" padding="24px 24px 8px 24px">
  <mj-column>
    <mj-image css-class="logo-light" src="[[ t.logo.url ]]" alt="[[ t.logo.alt ]]" href="[[ t.logo.href ]]" width="[[ t.logo.width ]]" align="center" padding="0" />
    [% if t.dark %]
    <mj-image css-class="logo-dark" src="[[ t.dark.logoUrl ]]" alt="[[ t.logo.alt ]]" href="[[ t.logo.href ]]" width="[[ t.logo.width ]]" align="center" padding="0" />
    [% endif %]
  </mj-column>
</mj-section>
[% endmacro %]
