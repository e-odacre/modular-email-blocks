[# hero: background image with heading, subheading and optional button.

   Compatibility
   - Outlook desktop: mj-hero writes a VML fallback so the background image still shows. The heading and text
     sit on t.colors.primary if the image is blocked, so keep primaryText readable on primary.
   - Gmail apps and most clients block or crop background images differently. The solid background-color
     fallback is what people see when images are off, never rely on the image to carry the message.
   - Dark mode: the hero keeps its own colors on purpose, it is a branded block.
   - Pass image=none to get a plain colored hero. #]
[% macro hero(heading, subheading, ctaLabel=none, ctaHref=none, image=none) %]
<mj-hero mode="fixed-height" height="320px" background-color="[[ t.colors.primary ]]"[% if image %] background-url="[[ image ]]" background-width="[[ t.layout.width ]]" background-height="320px"[% endif %] background-position="center center" padding="0">
  <mj-text align="center" color="[[ t.colors.primaryText ]]" font-family="[[ t.fonts.heading ]]" font-size="[[ t.type.h1Size ]]" font-weight="bold" line-height="1.2" padding="0 32px 12px 32px">[[ heading ]]</mj-text>
  <mj-text align="center" color="[[ t.colors.primaryText ]]" padding="0 32px">[[ subheading ]]</mj-text>
  [% if ctaLabel and ctaHref %]
  <mj-button href="[[ ctaHref ]]" align="center" background-color="[[ t.colors.primaryText ]]" color="[[ t.colors.primary ]]" border-radius="[[ t.layout.radius ]]" font-family="[[ t.fonts.heading ]]" font-weight="bold" inner-padding="14px 28px" padding="24px 32px 0 32px">[[ ctaLabel ]]</mj-button>
  [% endif %]
</mj-hero>
[% endmacro %]
